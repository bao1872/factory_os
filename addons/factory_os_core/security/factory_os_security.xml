<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_factory_os" model="ir.module.category">
        <field name="name">Factory OS</field>
        <field name="sequence">35</field>
    </record>

    <record id="groups_privilege_factory_os" model="res.groups.privilege">
        <field name="name">Factory OS Access</field>
        <field name="sequence">35</field>
        <field name="category_id" ref="module_category_factory_os"/>
    </record>

    <record id="group_factory_os_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="groups_privilege_factory_os"/>
        <field name="implied_ids"
               eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_factory_os_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="groups_privilege_factory_os"/>
        <field name="implied_ids"
               eval="[(4, ref('group_factory_os_user'))]"/>
    </record>

    <record id="group_factory_os_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="groups_privilege_factory_os"/>
        <field name="implied_ids"
               eval="[(4, ref('group_factory_os_manager'))]"/>
    </record>

    <!-- Functional groups: independently combinable roles -->

    <record id="group_factory_sales_manager" model="res.groups">
        <field name="name">Factory OS / Sales</field>
        <field name="implied_ids"
               eval="[(4, ref('group_factory_os_user'))]"/>
    </record>

    <record id="group_factory_purchase_manager" model="res.groups">
        <field name="name">Factory OS / Purchasing</field>
        <field name="implied_ids"
               eval="[(4, ref('group_factory_os_user'))]"/>
    </record>

    <record id="group_factory_inventory_manager" model="res.groups">
        <field name="name">Factory OS / Warehouse</field>
        <field name="implied_ids"
               eval="[(4, ref('group_factory_os_user'))]"/>
    </record>

    <record id="group_factory_product_manager" model="res.groups">
        <field name="name">Factory OS / Product Manager</field>
        <field name="implied_ids"
               eval="[(4, ref('group_factory_os_user'))]"/>
    </record>

    <record id="group_factory_production_manager" model="res.groups">
        <field name="name">Factory OS / Production Manager</field>
        <field name="implied_ids"
               eval="[(4, ref('group_factory_os_user'))]"/>
    </record>

    <record id="group_factory_operator" model="res.groups">
        <field name="name">Factory OS / Operator</field>
        <field name="implied_ids"
               eval="[(4, ref('group_factory_os_user'))]"/>
    </record>

    <record id="group_factory_quality_manager" model="res.groups">
        <field name="name">Factory OS / Quality</field>
        <field name="implied_ids"
               eval="[(4, ref('group_factory_os_user'))]"/>
    </record>

    <record id="group_factory_delivery_manager" model="res.groups">
        <field name="name">Factory OS / Delivery</field>
        <field name="implied_ids"
               eval="[(4, ref('group_factory_os_user'))]"/>
    </record>

    <record id="group_factory_integration_admin" model="res.groups">
        <field name="name">Factory OS / Integration Admin</field>
        <field name="implied_ids"
               eval="[(4, ref('group_factory_os_user'))]"/>
    </record>

    <record id="group_factory_os_owner" model="res.groups">
        <field name="name">Owner</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="groups_privilege_factory_os"/>
        <field name="implied_ids"
               eval="[
                   (4, ref('group_factory_os_admin')),
                   (4, ref('group_factory_sales_manager')),
                   (4, ref('group_factory_purchase_manager')),
                   (4, ref('group_factory_inventory_manager')),
                   (4, ref('group_factory_product_manager')),
                   (4, ref('group_factory_production_manager')),
                   (4, ref('group_factory_operator')),
                   (4, ref('group_factory_quality_manager')),
                   (4, ref('group_factory_delivery_manager')),
                   (4, ref('group_factory_integration_admin'))
               ]"/>
        <field name="user_ids"
               eval="[
                   (4, ref('base.user_admin')),
                   (4, ref('base.user_root'))
               ]"/>
    </record>

</odoo>
